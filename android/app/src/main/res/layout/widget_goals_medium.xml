<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#16181b"
    android:padding="16dp">

    <!-- Top Header: Week Label & Monthly Indicator -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_week_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Week 1 • Thursday"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Small indicator showing overall cumulative Monthly Goal progress -->
        <TextView
            android:id="@+id/tv_monthly_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Month: 64%"
            android:textColor="#818cf8"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="#1e1b4b"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp" />
    </LinearLayout>

    <!-- Sunday Off / Rest Day message -->
    <TextView
        android:id="@+id/tv_sunday_rest"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:text="☕ Sunday OFF / REST DAY\nNo active goals required today."
        android:textColor="#fcd34d"
        android:textSize="11sp"
        android:visibility="gone" />

    <!-- Active Goals Container -->
    <LinearLayout
        android:id="@+id/layout_active_goals"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:layout_marginVertical="6dp">

        <TextView
            android:id="@+id/tv_goal_item_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="✓ Deep Focus: 4/4 hrs"
            android:textColor="#e2e8f0"
            android:textSize="11sp"
            android:singleLine="true" />

        <TextView
            android:id="@+id/tv_goal_item_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="○ Gym Workout: 0/1 session"
            android:textColor="#94a3b8"
            android:textSize="11sp"
            android:singleLine="true" />
    </LinearLayout>

    <!-- Week Progress Bar and Percentage -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Current Week Progress"
            android:textColor="#94a3b8"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/tv_week_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="75%"
            android:textColor="#34d399"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/progress_week"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="3dp"
        android:max="100"
        android:progress="75"
        android:progressTint="#34d399" />

</LinearLayout>
